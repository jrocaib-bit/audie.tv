# Local only. Copy to apps/web/.env.local or apps/mobile/.env when a value is needed.
# The URL identifies the Audite Supabase project. Keys stay empty in git.

AUDITE_DEMO=
EXPO_PUBLIC_AUDITE_DEMO=
EXPO_PUBLIC_CONTENT_BASE=http://127.0.0.1:43123

# Project qdjowihivtqoelurvyke, region eu-west-1. See docs/MIGRACION.md.
# Not read by the running app until that module is wired. Do not put a real key here.
NEXT_PUBLIC_SUPABASE_URL=https://qdjowihivtqoelurvyke.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
RESEND_API_KEY=

# Server-only, later. Never ship this to the browser or the Expo app.
SUPABASE_SERVICE_ROLE_KEY=

# Solo en el servidor. Sin NEXT_PUBLIC. Si faltan, la web muestra [NIF] y [DIRECCIÓN].
LEGAL_TITULAR_NIF=
LEGAL_TITULAR_DIRECCION=
SOPORTE_DESTINO=
SOPORTE_ACUSE=
CORREO_ENVIO_REAL=
CORREO_DESTINOS_PERMITIDOS=
IP_HASH_SALT=
STORES_LIVE=
GOOGLE_LOGIN_ENABLED=
NEXT_PUBLIC_SITE_URL=https://audite.tv
GAZPACHO_FONTS_URL=

# Vacías a propósito. El repositorio es público.
NEXT_PUBLIC_AUDITE_APP_STORE_URL=
NEXT_PUBLIC_AUDITE_PLAY_URL=
EXPO_PUBLIC_SUPABASE_URL=https://qdjowihivtqoelurvyke.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
AUDITE_GOOGLE_CLIENT_ID=
AUDITE_GOOGLE_CLIENT_SECRET=
AUDITE_GOOGLE_IOS_CLIENT_ID=
AUDITE_APPLE_SERVICES_ID=
AUDITE_APPLE_SECRET=
AUDITE_APPLE_KEY_ID=
AUDITE_APPLE_TEAM_ID=
AUDITE_APPLE_BUNDLE_ID=
RESEND_API_KEY=

# La sala: vuelo en vivo desde el espacio (Google Photorealistic 3D Tiles, Map Tiles API + CesiumJS).
# EL REPOSITORIO ES PÚBLICO: esta clave NO se versiona. Déjala vacía aquí.
# - Local: ponla en apps/mobile/.env (ignorado por git). Expo la incrusta en el bundle al compilar.
# - Builds: variable de EAS EXPO_PUBLIC_GOOGLE_MAPS_API_KEY (se crea fuera del repo).
# Sin clave la app usa la entrada v2 (vídeo + fotos). Restringe la clave en Google Cloud (ver sala-google3d.md).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Texto en el reproductor. Ver docs/TEXTO_REPRODUCTOR.md.
# Interruptor maestro. Solo "1" lo enciende. Vacío en producción hasta confirmar la licencia del texto.
TEXTO_BIBLICO_ACTIVO=
# Quién lee el texto: como-audio (por defecto), suscripcion o abierto (solo pruebas).
TEXTO_ACCESO=
# Carpeta local con <idioma>/<episodio>.json. Solo en tu equipo, nunca en producción.
AUDITE_TEXTO_RUTA=
# Futuro: bucket privado del texto en producción. Aún sin implementar.
# TEXTO_BUCKET=texto
# Fuente del texto: torres-amat (por defecto, dominio público, versionada en content/texto/torres-amat) o ninguna.
# AUDITE_TEXTO_RUTA, si se define, tiene prioridad sobre la fuente.
TEXTO_FUENTE=
