{
  "name": "audite",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @audite/web",
    "build": "npm run build -w @audite/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/domain --noEmit && tsc -p packages/content --noEmit && tsc -p packages/data --noEmit && tsc -p apps/web --noEmit && npm --prefix apps/mobile run typecheck",
    "validate": "tsx packages/content/src/cli.ts",
    "catalog": "tsx packages/content/src/cli.ts --write-catalog",
    "content:sync": "tsx scripts/sync-content.ts",
    "content:fixture": "tsx scripts/materializar-piloto.ts",
    "lint": "npm run lint -w @audite/web"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
